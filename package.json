    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "unplugin-import-bin": "^0.1.5",
    "vite": "^7.0.1",
    "wasm-pack": "^0.13.1"
  }
